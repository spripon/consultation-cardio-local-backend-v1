:80 {
	encode zstd gzip

	# Origine HTTP locale uniquement. Le HTTPS public est termine par Cloudflare,
	# puis cloudflared relaie vers http://127.0.0.1:8091 sur l'hote.
	# Caddy n'effectue donc aucun ACME/Let's Encrypt dans ce mode.

	# Controle d'acces OBLIGATOIRE (fail-closed). Les identifiants proviennent
	# de deploy/caddy.env (env_file obligatoire dans compose) et ne sont jamais
	# committes. BASIC_AUTH_HASH doit rester single-quoted dans caddy.env.
	basic_auth * {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		# Ces en-tetes sont transmis par Cloudflare au navigateur final.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API locale : meme origine publique que le frontend. FastAPI reste
	# uniquement joignable sur le reseau Docker interne, jamais publie sur l'hote.
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Frontend statique (build Vite embarque dans l'image web).
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 20MB
	}

	# Journalisation sans corps de requete ni contenu patient.
	log {
		output file /data/access.log
		format json
	}
}
