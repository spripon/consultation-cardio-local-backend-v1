# Remplacer par le domaine réel ; utiliser :80 pour un test LAN sans TLS.
consultation.cardiologie-tarbes.org {
	encode zstd gzip

	# Contrôle d'accès OBLIGATOIRE (fail-closed) : aucune configuration
	# optionnelle, aucun glob tolérant l'absence de fichier. Les identifiants
	# proviennent de deploy/caddy.env (env_file obligatoire dans compose) et ne
	# sont JAMAIS committés. Générer le hash :
	#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext '<motdepasse>'
	# Le mot de passe en clair ne doit jamais figurer dans Git ni dans caddy.env.
	basic_auth * {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "microphone=(self), camera=(self), geolocation=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		# CSP compatible avec le bundle Vite (styles injectés) et strictement même origine :
		# aucune connexion sortante vers un service tiers n'est autorisée par le navigateur.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# API locale : même origine que le frontend, donc pas de CORS en production.
	handle /api/* {
		reverse_proxy api:8000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Frontend statique (build Vite).
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	request_body {
		max_size 20MB
	}

	# Journalisation sans contenu patient.
	log {
		output file /data/access.log
		format json
	}
}
