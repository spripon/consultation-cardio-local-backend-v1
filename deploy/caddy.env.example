# Copier vers deploy/caddy.env (ignoré par Git, JAMAIS committé).
# `docker compose up` échoue si deploy/caddy.env est absent : le site public
# ne peut donc jamais démarrer sans authentification.
#
# Générer le hash (le mot de passe en clair ne doit jamais être stocké ici) :
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'MotDePasseFort'
# Copier la sortie ($2a$14$...) dans BASIC_AUTH_HASH.
BASIC_AUTH_USER=cardio
BASIC_AUTH_HASH=$2a$14$REMPLACER_PAR_LE_HASH_GENERE_LOCALEMENT
