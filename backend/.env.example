# --- Application ---
APP_ENV=production
CORS_ORIGINS=https://consultation.cardiologie-tarbes.org

# --- Limites ---
MAX_UPLOAD_SIZE=20971520
MAX_PDF_PAGES=20
OCR_TIMEOUT_SECONDS=120
TEMP_DIR=/tmp/consultation-cardio

# --- OCR local ---
TESSERACT_LANG=fra+eng
OCR_DPI=300
ENABLE_HEIC=true

# --- Anonymisation locale ---
# gdpr_pseudonymization (défaut cardio : conserve âge/sexe/dates cliniques)
# strict_no_leak (retire aussi âge/sexe/dates)
OPENMED_POLICY=gdpr_pseudonymization
OPENMED_PII_MODEL=/models/openmed-pii
# true = /extract renvoie 503 si le modèle PII local est absent (recommandé en production)
REQUIRE_OPENMED=false
REDACT_DOCTOR_NAMES=true
HF_HUB_OFFLINE=true

# --- Dictée locale (optionnelle) ---
ENABLE_SPEECH=false
WHISPER_MODEL_PATH=/models/faster-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr

# --- Débogage (interdit si APP_ENV=production) ---
ALLOW_RAW_OCR_DEBUG=false

# --- Réservé V2, non appelé en V1 ---
ENABLE_LOCAL_LLM=false
# LOCAL_LLM_URL=http://127.0.0.1:11434